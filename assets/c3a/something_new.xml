<tamination title="Something New">

  <tam title="Something New" from="Right-Hand Columns">
    <formation>
      <dancer gender="boy" x="-3" y="-1" angle="180"/>
      <dancer gender="boy" x="-1" y="-1" angle="180"/>
      <dancer gender="girl" x="1" y="-1" angle="180"/>
      <dancer gender="girl" x="3" y="-1" angle="180"/>
    </formation>
    <path couples="3 1">
      <move select="Run Right"/>
    </path>
    <path couples="4 2">
      <move select="Forward"/>
      <move select="U-Turn Right" beats="2" offsetX="1"/>
    </path>
    <path couples="2 4">
      <move select="U-Turn Right" beats="3" offsetX="1"/>
    </path>
    <path couples="1 3">
      <move select="Extend Left" beats="3" scaleX="3" scaleY="2"/>
    </path>
  </tam>

</tamination>
