<tamination title="Slip the Clutch">

  <tam title="Slip the Clutch"
       from="Thar"
       formation="Thar RH Boys">
    <path>
      <move select="HalfHinge Right" beats="2"/>
    </path>
    <path>
      <move select="Lead Left 1/2" scaleX="3" scaleY="3" beats="2" />
    </path>
    <path>
      <move select="HalfHinge Right" beats="2"/>
    </path>
    <path>
      <move select="Lead Left 1/2" scaleX="3" scaleY="3" beats="2" />
    </path>
  </tam>

  <tam title="Slip the Clutch"
       from="Wrong Way Thar"
       formation="Thar LH Boys">
    <path>
      <move select="HalfHinge Left" beats="2"/>
    </path>
    <path>
      <move select="Lead Right 1/2" scaleX="3" scaleY="3" beats="2" />
    </path>
    <path>
      <move select="HalfHinge Left" beats="2"/>
    </path>
    <path>
      <move select="Lead Right 1/2" scaleX="3" scaleY="3" beats="2" />
    </path>
  </tam>

</tamination>
