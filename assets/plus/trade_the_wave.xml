<tamination title="Trade the Wave">

  <tam title="Trade the Wave"
       from="Right-Hand Wave"
       formation="Wave RH Boys Center"
       difficulty="2">
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
  </tam>

  <tam title="Trade the Wave" from="Compact Right-Hand Wave" display="none"
       formation="Compact Wave RH">
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="1" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="1" />
    </path>
  </tam>

  <tam title="Trade the Wave"
       from="Left-Hand Wave"
       formation="Wave LH Boys Center"
       difficulty="1">
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
  </tam>

  <tam title="Trade the Wave" from="Compact Left-Hand Wave" display="none"
       formation="Compact Wave LH">
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="1" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="1" />
    </path>
  </tam>

  <tam title="Trade the Wave"
       from="Right-Hand Waves"
       formation="Ocean Waves RH BGGB"
       difficulty="2">
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
  </tam>

  <tam title="Trade the Wave"
       from="Left-Hand Waves"
       formation="Ocean Waves LH GBBG"
       difficulty="1">
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" scaleY="2" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" scaleY="2" />
    </path>
  </tam>

  <tam title="Trade the Wave"
       from="Right-Hand Tidal Wave"
       formation="Tidal Wave RH BGGB"
       difficulty="2">
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" />
    </path>
  </tam>

  <tam title="Trade the Wave"
       from="Left-Hand Tidal Wave"
       formation="Tidal Wave LH BGGB"
       fractions="" difficulty="2">
    <path>
      <move select="Run Left" beats="6" scaleX=".5" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" />
    </path>
    <path>
      <move select="Run Right" beats="6" scaleX="1.5" />
    </path>
    <path>
      <move select="Run Left" beats="6" scaleX=".5" />
    </path>
  </tam>
</tamination>
