<tamination title="Fractional Tops">

  <tam title="Quarter the Top"
       from="Thar"
       formation="Thar RH Boys"
       parts="3" >
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Lead Right 1/2" hands="right" />
      <move select="Hinge Right 1/4"/>
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Lead Right 1/2" hands="right" />
      <move select="Hinge Right 1/4"/>
    </path>
  </tam>

  <tam title="Quarter the Top"
       from="Wrong Way Thar"
       formation="Thar LH Boys"
       parts="3" >
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Lead Left 1/2" hands="left" />
      <move select="Hinge Left 1/4"/>
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Lead Left 1/2" hands="left" />
      <move select="Hinge Left 1/4"/>
    </path>
  </tam>

  <tam title="Half the Top"
       from="Thar"
       formation="Thar RH Boys"
       parts="3" >
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/2" beats="2.25" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Hinge Right" />
      <move select="Lead Right 1/2" hands="right" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/2" beats="2.25" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Hinge Right" />
      <move select="Lead Right 1/2" hands="right" />
    </path>
  </tam>

  <tam title="Half the Top"
       from="Wrong Way Thar"
       formation="Thar LH Boys"
       parts="3" >
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/2" beats="2.25" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Hinge Left" />
      <move select="Lead Left 1/2" hands="left" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/2" beats="2.25" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Hinge Left" />
      <move select="Lead Left 1/2" hands="left" />
    </path>
  </tam>

  <tam title="3/4 the Top"
       from="Thar"
       formation="Thar RH Boys"
       parts="3" >
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/2" beats="2.25" scaleX="3" scaleY="3" />
      <move select="Lead Left 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Swing Right" />
      <move select="Hinge Right 1/4"/>
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Lead Left 1/2" beats="2.25" scaleX="3" scaleY="3" />
      <move select="Lead Left 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Left" />
      <move select="Swing Right" />
      <move select="Hinge Right 1/4"/>
    </path>
  </tam>

  <tam title="3/4 the Top"
       from="Wrong Way Thar"
       formation="Thar LH Boys"
       parts="3" >
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/2" beats="2.25" scaleX="3" scaleY="3" />
      <move select="Lead Right 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Swing Left" />
      <move select="Hinge Left 1/4"/>
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Lead Right 1/2" beats="2.25" scaleX="3" scaleY="3" />
      <move select="Lead Right 1/4" beats="1.125" scaleX="3" scaleY="3" />
    </path>
    <path>
      <move select="Swing Right" />
      <move select="Swing Left" />
      <move select="Hinge Left 1/4"/>
    </path>
  </tam>

</tamination>
