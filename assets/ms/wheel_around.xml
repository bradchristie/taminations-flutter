<tamination title="Wheel Around">

  <tam title="Wheel Around"
       from="Facing Couples"
       formation="Facing Couples Compact" sequencer="no">
    <path>
      <move select="Beau Wheel" />
    </path>
    <path>
      <move select="Belle Wheel" />
    </path>
  </tam>

  <tam title="Wheel Around"
       from="Couples Facing Out"
       formation="Couples Facing Out Compact" sequencer="no">
    <path>
      <move select="Belle Wheel" />
    </path>
    <path>
      <move select="Beau Wheel" />
    </path>
  </tam>

  <tam title="Wheel Around"
       from="Lines"
       formation="Normal Lines">
    <path>
      <move select="Beau Wheel" />
    </path>
    <path>
      <move select="Belle Wheel" />
    </path>
    <path>
      <move select="Beau Wheel" />
    </path>
    <path>
      <move select="Belle Wheel" />
    </path>
  </tam>

  <tam title="Wheel Around"
       from="Eight Chain Thru"
       formation="Eight Chain Thru">
    <path>
      <move select="Beau Wheel" scaleX=".5"/>
    </path>
    <path>
      <move select="Belle Wheel" scaleX=".5"/>
    </path>
    <path>
      <move select="Beau Wheel" scaleX=".5"/>
    </path>
    <path>
      <move select="Belle Wheel" scaleX=".5"/>
    </path>
  </tam>

  <tam title="Heads Wheel Around"
       from="Promenade"
       formation="Promenade 2">
    <path>
    <move select="BackHinge Right" scaleX=".5" scaleY=".5"/>
    <move select="HalfBackHinge Right" scaleX=".5" scaleY=".5" offsetX="-.35" offsetY=".35"/>
    </path>
    <path>
      <move select="Hinge Left" scaleX=".5" scaleY=".5"/>
      <move select="Eighth Left" hands="left" beats=".75" offsetX=".60" offsetY="-.10" />
    </path>
    <path>
      <move select="HalfBackHinge Right" scaleX=".5" scaleY=".5" offsetX="-.25" offsetY=".25"/>
    </path>
    <path>
      <move select="Eighth Left" hands="left" beats=".75" offsetX=".71" offsetY="-.20" />
    </path>
  </tam>

  <tam title="Reverse Wheel Around"
       from="Facing Couples"
       formation="Facing Couples Compact"
       sequencer="no">
    <path>
      <move select="Belle Wheel" reflect="1" />
    </path>
    <path>
      <move select="Beau Wheel" reflect="1" />
    </path>
  </tam>

  <tam title="Reverse Wheel Around"
       from="Couples Facing Out"
       formation="Couples Facing Out Compact"
       sequencer="no">
    <path>
      <move select="Beau Wheel" reflect="1" />
    </path>
    <path>
      <move select="Belle Wheel" reflect="1" />
    </path>
  </tam>

  <tam title="Reverse Wheel Around"
       from="Lines"
       formation="Normal Lines">
    <path>
      <move select="Belle Wheel" reflect="-1" />
    </path>
    <path>
      <move select="Beau Wheel" reflect="-1" />
    </path>
    <path>
      <move select="Belle Wheel" reflect="-1" />
    </path>
    <path>
      <move select="Beau Wheel" reflect="-1" />
    </path>
  </tam>

  <tam title="Reverse Wheel Around"
       from="Eight Chain Thru"
       formation="Eight Chain Thru">
    <path>
      <move select="Belle Wheel" reflect="-1" scaleX=".5"/>
    </path>
    <path>
      <move select="Beau Wheel" reflect="-1" scaleX=".5"/>
    </path>
    <path>
      <move select="Belle Wheel" reflect="-1" scaleX=".5"/>
    </path>
    <path>
      <move select="Beau Wheel" reflect="-1" scaleX=".5"/>
    </path>
  </tam>

</tamination>
