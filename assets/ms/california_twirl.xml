<tamination title="California Twirl">

  <tam title="California Twirl" from="Facing Couples" formation="Facing Couples" sequencer="no">
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
  </tam>

  <tam title="California Twirl"
       from="Couples Facing Out"
       formation="Couples Facing Out" sequencer="no">
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
  </tam>

  <tam title="California Twirl"
       from="Lines Facing Out"
       formation="Lines Facing Out" sequencer="gender-specific">
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
  </tam>

  <tam title="California Twirl"
       from="Completed Double Pass Thru"
       formation="Completed Double Pass Thru" sequencer="gender-specific">
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
    <path>
      <move select="Flip Left" hands="gripleft" />
    </path>
    <path>
      <move select="Run Right" hands="gripright" />
    </path>
  </tam>
</tamination>
