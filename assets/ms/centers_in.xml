<tamination title="Centers In">

  <tam title="Centers In"
       from="Completed Double Pass Thru"
       formation="Completed Double Pass Thru"
       difficulty="1" >
    <path>
      <move select="Dodge Right" beats="2" offsetX="-1" />
    </path>
    <path>
      <move select="Dodge Left" beats="2" offsetX="-1" />
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="right" beats="2" />
    </path>
  </tam>

  <tam title="Centers In"
       from="Eight Chain Thru"
       formation="Eight Chain Thru"
       difficulty="2" >
    <path>
      <move select="Dodge Left" beats="2" offsetX="1" />
    </path>
    <path>
      <move select="Dodge Right" beats="2" offsetX="1" />
    </path>
    <path>
      <move select="Forward" hands="right" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" />
    </path>
  </tam>

  <tam title="Centers In" display="none"
       from="Outer Right-Hand Mini-Wave">
    <formation>
      <dancer gender="girl" x="-3" y="1" angle="0"/>
      <dancer gender="boy" x="-3" y="-1" angle="180"/>
      <dancer gender="girl" x="-1" y="1" angle="180"/>
      <dancer gender="boy" x="-1" y="-1" angle="180"/>
    </formation>
    <path>
      <move select="Dodge Left" beats="2" offsetX="1" />
    </path>
    <path>
      <move select="Dodge Left" beats="2" offsetX="-1" />
    </path>
    <path>
      <move select="Forward" hands="right" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" />
    </path>
  </tam>

  <tam title="Centers In" display="none"
       from="Outer Left-Hand Mini-Wave">
    <formation>
      <dancer gender="girl" x="-3" y="1" angle="180"/>
      <dancer gender="boy" x="-3" y="-1" angle="0"/>
      <dancer gender="girl" x="-1" y="1" angle="180"/>
      <dancer gender="boy" x="-1" y="-1" angle="180"/>
    </formation>
    <path>
      <move select="Dodge Right" beats="2" offsetX="-1" />
    </path>
    <path>
      <move select="Dodge Right" beats="2" offsetX="1" />
    </path>
    <path>
      <move select="Forward" hands="right" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" />
    </path>
  </tam>

</tamination>
