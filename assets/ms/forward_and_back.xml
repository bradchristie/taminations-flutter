<tamination title="Forward and Back">

  <tam title="Forward and Back" from="Facing Couples"
       formation="Facing Couples Compact">
    <path>
      <move select="Forward" hands="right" beats="2" scaleX="0.7" />
      <move select="Back" hands="right" beats="2" scaleX="0.7"/>
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" scaleX="0.7"/>
      <move select="Back" hands="left" beats="2" scaleX="0.7"/>
    </path>
  </tam>

  <tam title="Forward and Back"
       from="Lines"
       formation="Normal Lines">
    <path>
      <move select="Forward" hands="right" beats="2" />
      <move select="Back" hands="right" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="both" beats="2" />
      <move select="Back" hands="both" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="both" beats="2" />
      <move select="Back" hands="both" beats="2" />
    </path>
    <path>
      <move select="Forward" hands="left" beats="2" />
      <move select="Back" hands="left" beats="2" />
    </path>
  </tam>

  <tam title="Heads Forward and Back" from="Static Square"
       formation="Static Square" group=" ">
    <path>
      <move select="Forward 2" hands="right" beats="4" />
      <move select="Back 2" hands="right" beats="4" />
    </path>
    <path>
      <move select="Forward 2" hands="left" beats="4" />
      <move select="Back 2" hands="left" beats="4" />
    </path>
    <path/>
    <path/>
  </tam>

  <tam title="Sides Forward and Back" from="Static Square"
       formation="Static Square" display="none">
    <path/>
    <path/>
    <path>
      <move select="Forward 2" hands="right" beats="4" />
      <move select="Back 2" hands="right" beats="4" />
    </path>
    <path>
      <move select="Forward 2" hands="left" beats="4" />
      <move select="Back 2" hands="left" beats="4" />
    </path>
  </tam>

</tamination>
