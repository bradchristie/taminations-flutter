<tamination title="Trade By">

  <tam title="Trade By"
       from="Trade By"
       formation="Trade By"
       difficulty="1">
    <path>
      <move select="Flip Left" beats="4"/>
    </path>
    <path>
      <move select="Run Right" beats="4"/>
    </path>
    <path>
      <move select="Extend Left" beats="2" scaleY=".5" />
      <move select="Extend Right" beats="2" scaleY=".5" />
    </path>
    <path>
      <move select="Extend Left" beats="2" scaleY=".5" />
      <move select="Extend Right" beats="2" scaleY=".5" />
    </path>
  </tam>

  <tam title="Trade By"
       from="3/4 Tag"
       formation="3/4 Tag"
       difficulty="2">
    <path>
      <move select="Flip Left" beats="4" />
    </path>
    <path>
      <move select="Run Right" beats="4" />
    </path>
    <path>
      <move select="Extend Right" beats="4" scaleY="2" />
    </path>
    <path>
      <move select="Forward" beats="4" />
    </path>
  </tam>

  <tam title="Trade By"
       from="T-Bones"
       formation="T-Bone LUUR"
       difficulty="2">
    <path>
      <move select="Run Right" beats="4"/>
    </path>
    <path>
      <move select="Flip Left" beats="4"/>
    </path>
    <path>
      <move select="Extend Left" beats="2" scaleY=".5" />
      <move select="Extend Right" beats="2" scaleY=".5" />
    </path>
    <path>
      <move select="Extend Left" beats="2" scaleY=".5" />
      <move select="Extend Right" beats="2" scaleY=".5" />
    </path>
  </tam>

</tamination>
