<tamination title="Swing">

  <tam title="Swing Your Partner" from="Facing Couples" formation="Facing Couples">
    <path>
      <move select="Lead Right" scaleX=".75" scaleY=".5"/>
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Dodge Left" hands="right" scaleY=".375" />
    </path>
    <path>
      <move select="Quarter Left" offsetX=".25" offsetY=".5"/>
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="U-Turn Right" hands="left" offsetX="1" offsetY=".75" />
    </path>
  </tam>

  <tam title="Swing Your Corner"
       from="Facing Couples"
       formation="Facing Couples"
       fractions="" >
    <path>
      <move select="Extend Left" scaleX="1.5" scaleY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Dodge Left" hands="right" scaleY=".375" />
    </path>
    <path>
      <move select="Extend Left" scaleX="1.5" scaleY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="Quarter Right" offsetX=".75" offsetY=".25" />
      <move select="U-Turn Right" hands="left" offsetX="1" offsetY=".75" />
    </path>
  </tam>
</tamination>
